datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  INVESTOR
  CLUB
  ADMIN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  IPO_RESERVATION
  IPO_REFUND
  TRADE_BUY
  TRADE_SELL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum IpoStatus {
  DRAFT
  ACTIVE
  SUCCESSFUL
  FAILED
  CANCELLED
}

enum ReservationStatus {
  RESERVED
  CONFIRMED
  REFUNDED
}

model User {
  id              String           @id @default(uuid())
  name            String
  document        String           @unique
  email           String           @unique
  passwordHash    String
  role            UserRole         @default(INVESTOR)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  wallet          Wallet?
  athletes        Athlete[]        @relation("ClubAthletes")
  ipoReservations IpoReservation[]

  @@map("users")
}

model Wallet {
  id               String              @id @default(uuid())
  userId           String              @unique
  availableBalance Decimal             @default(0.00) @db.Decimal(18, 4)
  reservedBalance  Decimal             @default(0.00) @db.Decimal(18, 4)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     LedgerTransaction[]

  @@map("wallets")
}

model LedgerTransaction {
  id          String            @id @default(uuid())
  walletId    String
  type        TransactionType
  amount      Decimal           @db.Decimal(18, 4)
  fee         Decimal           @default(0.00) @db.Decimal(18, 4)
  status      TransactionStatus @default(PENDING)
  description String?
  referenceId String?
  createdAt   DateTime          @default(now())

  wallet      Wallet            @relation(fields: [walletId], references: [id])

  @@map("ledger_transactions")
}

model Athlete {
  id          String     @id @default(uuid())
  name        String
  position    String
  clubId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  club        User       @relation("ClubAthletes", fields: [clubId], references: [id])
  ipoOffers   IpoOffer[]

  @@map("athletes")
}

model IpoOffer {
  id             String           @id @default(uuid())
  athleteId      String
  sharePrice     Decimal          @db.Decimal(18, 4)
  totalShares    Int
  softCapShares  Int
  hardCapShares  Int
  soldShares     Int              @default(0)
  startDate      DateTime
  endDate        DateTime
  status         IpoStatus        @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  athlete        Athlete          @relation(fields: [athleteId], references: [id])
  reservations   IpoReservation[]

  @@map("ipo_offers")
}

model IpoReservation {
  id          String            @id @default(uuid())
  ipoOfferId  String
  userId      String
  sharesCount Int
  totalAmount Decimal           @db.Decimal(18, 4)
  status      ReservationStatus @default(RESERVED)
  createdAt   DateTime          @default(now())

  ipoOffer    IpoOffer          @relation(fields: [ipoOfferId], references: [id])
  user        User              @relation(fields: [userId], references: [id])

  @@map("ipo_reservations")
}